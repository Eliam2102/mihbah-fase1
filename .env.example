# ────────────────────────────────────────────────────────────────────────────
# MIHBAH FASE 1 — Variables de entorno (plantilla)
# Copia este archivo a `.env` y completa los valores.  NUNCA subas `.env` al repo.
#   cp .env.example .env
# ────────────────────────────────────────────────────────────────────────────

# ── Base de datos (PostgreSQL) ──────────────────────────────────────────────
# URL completa en formato postgresql://USER:PASSWORD@HOST:PORT/DB
# En local (docker-compose): ver docker-compose.yml  →  puerto 5433
DATABASE_URL=postgresql://mihbah:password@localhost:5433/mihbah_dev

# ── Better Auth ─────────────────────────────────────────────────────────────
# Secret de firma de sesión.  Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# URL base accesible desde el navegador (sin slash final).
# En prod debe ser la URL pública del deploy, ej.  https://mihbah-fase1.onrender.com
BETTER_AUTH_URL=http://localhost:3000

# Forzar cookies "secure".  Activar solo si la app corre tras HTTPS
# (Render/Vercel/producción).  En local déjalo vacío.
SECURE_COOKIES=

# ── Cifrado de campos sensibles (clabe interbancaria, etc.) ────────────────
# Clave maestra en HEX de 64 caracteres (32 bytes).
# Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OBLIGATORIA en producción.  Si no se establece en dev, la app guarda en claro
# con warning.  Al rotar la clave, los datos previamente cifrados no se podrán
# descifrar — migrar primero.
FIELD_ENCRYPTION_KEY=

# ── Monday.com (sincronización de ventas) ───────────────────────────────────
MONDAY_API_KEY=
MONDAY_BOARD_ID=

# ── Almacenamiento de comprobantes ──────────────────────────────────────────
# Carpeta local donde se guardan los comprobantes de pago subidos en dev.
# En producción Render/Easypanel se monta como volumen persistente.
COMPROBANTES_DIR=./.uploads/comprobantes

# ── Sentry ──────────────────────────────────────────────────────────────────
# DSN del proyecto Sentry (puede ser público — solo identifica el proyecto).
NEXT_PUBLIC_SENTRY_DSN=
# La URL del MCP de Sentry vive en `.mcp.json` (no se versiona — copia de
# `.mcp.example.json`).  El auth token del CLI y el build plugin están en
# `.env.sentry-build-plugin` (también gitignored).

# ── Solo para scripts de validación local (screenshots/seed) ────────────────
# No son necesarios para `next dev`.  Usados por `scripts/screenshots-validacion.ts`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
PORTAL_EMAIL=
PORTAL_PASSWORD=
BASE_URL=http://localhost:3000